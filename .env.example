# Public URL of this server, no trailing slash. Must be reachable over HTTPS from Meta's cloud.
PUBLIC_BASE_URL=https://connect.strategent.app

# Random string, 32+ characters. Signs OAuth tokens and slot tokens. Changing it signs everyone out.
#   openssl rand -base64 48
SIGNING_SECRET=

# Cal.com: API key (Settings, Developer, API keys) and the numeric id of the "AI Readiness Audit"
# event type. Run `npm run cal:setup` to list event types and find the id.
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
# Public booking page people can use themselves. Shown in written-audit replies.
BOOKING_PAGE_URL=cal.com/strategent/audit
# Meeting location to book. Blank uses whatever the event type defaults to.
CAL_LOCATION=google-meet
# Self-hosted Cal.com? Change the API host.
# CAL_API_BASE=https://api.cal.com
# Cal.com's API does not return reschedule or cancel links, so they are built from the booking uid.
# Verify these patterns with `npm run cal:setup -- --book you@example.com`; override if they 404.
# RESCHEDULE_URL_TEMPLATE=https://cal.com/reschedule/{uid}
# CANCEL_URL_TEMPLATE=https://cal.com/booking/{uid}?cancel=true

# Secret Cal.com signs webhook deliveries with (reschedules and cancellations). Set the same value on the webhook in
# Cal.com. Blank turns POST /webhooks/cal off. Generate with `openssl rand -base64 48`.
CAL_WEBHOOK_SECRET=

# Supabase: project URL and the service-role key (server only, never in a browser).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Alerts. Leave blank to skip. Slack incoming webhook for #leads; Resend for email.
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=info@strategent.app
NOTIFY_EMAIL_FROM=Strategent Connector <connector@strategent.app>
# Also email written-audit requesters a receipt. Off by default.
SEND_REQUESTER_ACK=false

# Pages Meta review opens. /privacy and /terms on the connector redirect here.
PRIVACY_URL=https://www.strategent.app/privacy-policy
TERMS_URL=https://www.strategent.app/terms-of-service

# Who the confirmation says the user will meet.
HOST_INTRO=Ruchi Singh, co-founder of Strategent

# Optional: comma-separated hostnames allowed as OAuth redirect targets (subdomains included).
# Blank allows any https URL, which is needed until we know Muse's redirect domain.
ALLOWED_REDIRECT_HOSTS=

# Abuse limits. Defaults shown.
BOOKING_HOURLY_CAP=20
PER_EMAIL_DAILY_CAP=3
WRITTEN_OPEN_CAP=10

# Slugs of the booking questions on the event type (`npm run cal:setup -- --create-fields` creates them).
# Defaults shown.
# CAL_FIELD_BUSINESS=business-name
# CAL_FIELD_WEBSITE=website
# CAL_FIELD_CITY=city
# CAL_FIELD_INDUSTRY=industry
# CAL_FIELD_PAIN=pain-point
# CAL_FIELD_PHONE=phone
# CAL_FIELD_CHANNEL=channel-interest
